# TRUCKLEAD AUTOPILOT - Environment Variables

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=trucklead_autopilot_secret_super_key_change_in_prod

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./trucklead.db
# PostgreSQL alternative for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trucklead_db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Sheets Integration (Service Account or OAuth)
# Option A: Path to Google Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: Raw JSON string of Service Account credentials
GOOGLE_SERVICE_ACCOUNT_JSON=
# Target Google Spreadsheet ID (found in Google Sheet URL: /d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=

# Search / Discovery API Keys (Optional fallbacks for enhanced rate limits)
SERPER_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# Browser Automation & Security
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=25000
MAX_CONCURRENT_RESEARCH_WORKERS=4
ENABLE_CAPTCHA_AUTO_PAUSE=true
