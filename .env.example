# TRUCKLEAD AUTOPILOT - Environment Variables Template
# Copy this file to .env and provide your secrets/configuration.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=

# Server & Database
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/trucklead.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/trucklead_db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Compliance & Identity (CAN-SPAM / TCPA)
POSTAL_ADDRESS=
SENDER_NAME=
SENDER_EMAIL=

# Google Sheets & Cloud
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=

# Official FMCSA / SODA API
SOCRATA_APP_TOKEN=

# Enrichment & Places APIs
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# Phone Verification APIs (Twilio Lookup v2, Telnyx, NumVerify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELNYX_API_KEY=
NUMVERIFY_API_KEY=

# Email Verification APIs (ZeroBounce, Hunter, Anymail finder, Apollo)
ZEROBOUNCE_API_KEY=
HUNTER_API_KEY=
ANYMAIL_API_KEY=
APOLLO_API_KEY=

# Browser Automation & Security
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=25000
MAX_CONCURRENT_RESEARCH_WORKERS=4
ENABLE_CAPTCHA_AUTO_PAUSE=true
